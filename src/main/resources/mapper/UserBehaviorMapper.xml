<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sundry.feed.UserBehaviorMapper">

    <insert id="insert" parameterType="com.sundry.feed.UserBehavior"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO user_behavior (user_id, event_type, product_id, category_id)
        VALUES (#{userId}, #{eventType}, #{productId}, #{categoryId})
    </insert>

</mapper>
