# 复制为 .env 后填写，.env 已被仓库忽略
AI_INTERNAL_TOKEN=change-me-to-a-long-random-string
DEEPSEEK_API_KEY=sk-your-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# Feed 重排只输出 JSON，用非推理模型；留空则跟随 DEEPSEEK_MODEL
FEED_RERANK_MODEL=deepseek-chat
AI_REQUEST_TIMEOUT_SECONDS=20

# 百炼 embedding（OpenAI 兼容）
EMBED_API_KEY=sk-your-bailian-key
EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBED_MODEL=qwen3.7-text-embedding-flash
EMBED_DIM=1024
EMBED_TIMEOUT_SECONDS=30
